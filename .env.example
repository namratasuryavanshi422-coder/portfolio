# ────────────────────────────────────────────────────────────────
#  CALENDLY
# ────────────────────────────────────────────────────────────────
# Your Calendly scheduling page URL (e.g. https://calendly.com/your-name)
# Leave empty to keep the "Schedule a Meeting" button disabled.
VITE_CALENDLY_URL=

# ────────────────────────────────────────────────────────────────
#  EMAILJS — contact form delivery
# ────────────────────────────────────────────────────────────────
# Required for the contact form to send emails.
# 1. Sign up at https://www.emailjs.com/
# 2. Create a service + an email template.
#    Template variables you can use: {{from_name}}, {{from_email}},
#    {{subject}}, {{message}}, {{reply_to}}, {{timestamp}},
#    {{from_ip}}, {{browser}}
# 3. Paste the three IDs below.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# ────────────────────────────────────────────────────────────────
#  Everything else lives in  src/config/site.ts  (email address,
#  LinkedIn, GitHub, X, LeetCode, Codeforces, Wellfound, resume
#  path and location). You never need to touch components.
# ────────────────────────────────────────────────────────────────
